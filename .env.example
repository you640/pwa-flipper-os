VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Server only: SUPABASE_URL, SUPABASE_ANON_KEY (or SUPABASE_PUBLISHABLE_KEY),
# SUPABASE_SERVICE_ROLE_KEY, LOVABLE_API_KEY, optional GITHUB_TOKEN.
# Never prefix server secrets with VITE_.
# Optional server-only TRUSTED_CLIENT_IP_HEADER: set ONLY to a header your
# gateway overwrites, with a single verified client IP. Without it anonymous AI
# is disabled (503); authenticated AI has a 10-per-24-hour server quota.
